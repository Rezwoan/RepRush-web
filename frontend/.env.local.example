NEXT_PUBLIC_API_URL=http://localhost:3001

# Clerk sign-in (https://dashboard.clerk.com → API keys).
# Leave BOTH blank to disable Clerk: the middleware no-ops, <ClerkProvider> is
# not mounted and /login shows the password form on its own.
#
# The secret key is needed HERE as well as in backend/.env — they are two
# separate processes with two separate env files, and `clerkMiddleware()` runs
# in this one. Setting only the publishable key makes every route 500 with
# "Missing secretKey" (which is why the middleware now requires both before it
# turns itself on).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Custom sign-in / sign-up pages live in this app, not on Clerk's hosted domain.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
