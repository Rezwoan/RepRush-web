NEXT_PUBLIC_API_URL=http://localhost:3001

# Clerk sign-in (https://dashboard.clerk.com → API keys).
# Leave blank to disable Clerk: the middleware no-ops, <ClerkProvider> is not
# mounted and /login shows the password form on its own.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# Custom sign-in / sign-up pages live in this app, not on Clerk's hosted domain.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
