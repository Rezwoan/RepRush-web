# Backups/copies of env files — these hold real secrets, never commit them.
# (Deliberately not `.env.*`, which would swallow the tracked .env.example.)
.env.bak*
.env.*.bak*
.env.local.bak*
*.env.bak*
.env.save
.env.orig

